{
  "servers": {
    "mindleak": {
      "type": "stdio",
      "command": "${userHome}/.mindleak/bin/mindleak-mcp",
      "cwd": "${workspaceFolder}",
      "env": {
        "MINDLEAK_AGENT": "copilot",
        "MINDLEAK_WORKSPACE": "${workspaceFolder}"
      }
    },
    "lodestar": {
      "type": "stdio",
      "command": "${userHome}/.mindleak/bin/lodestar-mcp",
      "cwd": "${workspaceFolder}",
      "env": {
        "LODESTAR_AGENT": "copilot",
        "MINDLEAK_WORKSPACE": "${workspaceFolder}"
      }
    }
  }
}
