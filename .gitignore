# Rust
/target
**/*.rs.bk
/coverage.lcov
/dist

# MindLeak graph database (regenerable)
.mindleak/
*.db
*.db-wal
*.db-shm

# Lodestar Intent Plane: task/lease state is local & regenerable; the exported
# constitution is committable.
/.lodestar/*
!.lodestar/CONSTITUTION.md

# Node / VS Code extension
**/node_modules
editors/vscode/out
editors/vscode/bin
editors/vscode/.vscode-test
editors/vscode/*.vsix
editors/vscode/media/vendor
editors/vscode/coverage/

# Local-only Copilot customization, not part of the shared repo convention
/.github/instructions/
/.github/prompts/

# Local Ackplane dev config (ports, salt path) -- see .env.example for the
# documented defaults; real values here are developer-machine-local only.
/.env

# Editor / OS
.DS_Store
Thumbs.db

# A linked worktree occasionally lands nested inside this checkout instead of
# as a sibling directory (ADR-0038 expects the latter). It carries its own
# .git file and is not this checkout's content; without this, an untracked
# nested worktree makes every status/clean-tree check here see "uncommitted
# changes" that are not actually uncommitted -- they belong to another branch
# entirely.
/MindLeak-*/
