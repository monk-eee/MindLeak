# Local Ackplane developer config. Copy to .env (gitignored) and adjust as
# needed; docker-compose.yml reads the ACKPLANE_* compose vars from .env
# automatically (Docker Compose's built-in convention). The
# ACKPLANE_BRIDGE_* vars are for running crates/ackplane-bridge directly
# (it is not part of the docker-compose.yml topology yet); they are read the
# same way, just by a plain process instead of `docker compose`.

# --- docker-compose.yml (postgres / migrate / ackplane) ---
ACKPLANE_POSTGRES_PORT=5432
ACKPLANE_PORT=8443
ACKPLANE_VERSION=dev
ACKPLANE_COMMIT=unknown

# --- crates/ackplane-bridge (run directly, e.g. target/release/ackplane-bridge) ---
ACKPLANE_DATABASE_URL=postgresql://ackplane:ackplane-development-only-not-for-production@127.0.0.1:5432/ackplane
ACKPLANE_BRIDGE_LISTEN=127.0.0.1:18150
ACKPLANE_BRIDGE_DEVELOPMENT_TENANT=local-dev
# ADR-0098 decision 3: a per-installation secret, generated once and
# persisted here (never derived from anything guessable, never committed).
# Losing this file means every prior enrollment under it becomes invisible
# to a fresh Bridge -- back it up along with the database, not separately.
ACKPLANE_BRIDGE_SALT_PATH=.mindleak/ackplane-bridge-salt.bin
# Snapshot (ADR-0119 decision 4 / ADR-0128): unset means the Snapshot
# capability reports `unavailable` rather than guessing a location.
# `pg_dump` must be on this process's PATH (or ACKPLANE_PG_DUMP_PATH point at
# it directly) -- Bridge is not containerized yet, so no image installs it.
ACKPLANE_SNAPSHOT_DIR=.mindleak/ackplane-snapshots
# Defaults to <ACKPLANE_SNAPSHOT_DIR>/snapshot-key.bin when unset. Generated
# once and persisted the same way ACKPLANE_BRIDGE_SALT_PATH is -- back it up
# alongside the encrypted snapshot artifacts it protects, not separately.
ACKPLANE_SNAPSHOT_KEY_PATH=.mindleak/ackplane-snapshot-key.bin
# Defaults to "pg_dump" (resolved via PATH) when unset.
ACKPLANE_PG_DUMP_PATH=pg_dump
